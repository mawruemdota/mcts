{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "description": "Unique Purchase Order Number"
    },
    "supplier_id": {
      "type": "string",
      "description": "Reference to the Supplier entity"
    },
    "supplier_name": {
      "type": "string",
      "description": "Name of the supplier"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Date the PO was issued"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Expected delivery or due date"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_name": {
            "type": "string",
            "description": "Name or brand of the item"
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the item"
          },
          "quantity": {
            "type": "number",
            "minimum": 1
          },
          "unit_price": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "minimum": 0
    },
    "shipping_cost": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "minimum": 0
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or instructions"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "rejected",
        "ordered",
        "received",
        "cancelled"
      ],
      "default": "draft"
    },
    "approved_by_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the user who approved the PO"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the PO was approved"
    },
    "requested_by_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the user who requested the PO"
    }
  },
  "required": [
    "po_number",
    "supplier_name",
    "issue_date",
    "items",
    "total_amount"
  ]
}