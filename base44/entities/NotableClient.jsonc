{
  "name": "NotableClient",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "description": "Name of the notable client"
    },
    "logo_url": {
      "type": "string",
      "format": "uri",
      "description": "URL of the client's logo"
    },
    "website_url": {
      "type": "string",
      "format": "uri",
      "description": "Client's website URL (optional)"
    },
    "order": {
      "type": "integer",
      "default": 0,
      "description": "Display order on homepage"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether to display this client on homepage"
    }
  },
  "required": [
    "client_name",
    "logo_url"
  ]
}